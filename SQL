10.

SELECT
    d.dept_id,
    d.dept_name,
    e.emp_id,
    e.emp_name,
    e.salary,
    CASE
        WHEN e.salary = x.highest_salary THEN 'HIGHEST'
        WHEN e.salary = x.lowest_salary THEN 'LOWEST'
    END AS salary_type,
    x.highest_salary - x.lowest_salary AS salary_difference
FROM Employees e
JOIN Departments d
    ON e.dept_id = d.dept_id
JOIN (
    SELECT
        dept_id,
        MAX(salary) AS highest_salary,
        MIN(salary) AS lowest_salary
    FROM Employees
    GROUP BY dept_id
) x
    ON e.dept_id = x.dept_id
WHERE e.salary = x.highest_salary
   OR e.salary = x.lowest_salary
ORDER BY d.dept_id, e.salary DESC;

