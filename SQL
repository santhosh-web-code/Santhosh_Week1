SELECT
    customer_id,
    completed_value,
    CASE
        WHEN completed_value >= 100000 THEN 'PLATINUM'
        WHEN completed_value >= 50000 THEN 'GOLD'
        WHEN completed_value >= 20000 THEN 'SILVER'
        ELSE 'BRONZE'
    END AS customer_class
FROM (
    SELECT
        customer_id,
        SUM(
            CASE
                WHEN status = 'Completed' THEN amount
                ELSE 0
            END
        ) AS completed_value
    FROM Orders
    GROUP BY customer_id
) x;
