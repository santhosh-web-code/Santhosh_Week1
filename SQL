SELECT
    order_date,
    daily_revenue,
    SUM(daily_revenue) OVER (
        ORDER BY order_date
    ) AS cumulative_revenue
FROM (
    SELECT
        order_date,
        SUM(amount) AS daily_revenue
    FROM Orders
    WHERE status = 'Completed'
    GROUP BY order_date
) x
ORDER BY order_date;
