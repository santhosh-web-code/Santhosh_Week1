def remove_loop(head):
    slow = head
    fast = head

    
    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next

        if slow == fast:
            break


    if slow != fast:
        return head

  
    slow = head

    while slow != fast:
        slow = slow.next
        fast = fast.next

    
    temp = slow

    while temp.next != slow:
        temp = temp.next

    temp.next = None

    return head

